cat > src/dress.tsx <<'EOF_DRESS'
import type { CSSProperties } from 'react';
import {
  defaultDesign,
  type DressDesign,
  type DressView,
  type FacePlacement,
} from './domain';

function esc(value: string) {
  return value.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
}

function fabricDefinition(design: DressDesign) {
  const base = design.fabric === 'mikado' ? '#fffdf9' : design.fabric === 'satin' ? '#fffaf4' : '#fffefd';
  const texture = {
    mikado: '',
    satin: '<linearGradient id="fabric" x1="0" x2="1"><stop stop-color="#fff"/><stop offset=".48" stop-color="#f4ebe5"/><stop offset=".72" stop-color="#fff"/><stop offset="1" stop-color="#eee1dc"/></linearGradient>',
    lace: '<pattern id="fabric" width="28" height="28" patternUnits="userSpaceOnUse"><rect width="28" height="28" fill="#fffdfb"/><path d="M3 14C8 4 20 4 25 14C20 24 8 24 3 14Z" fill="none" stroke="#dccbc5" stroke-width="1.5"/><circle cx="14" cy="14" r="3" fill="none" stroke="#dccbc5"/></pattern>',
    tulle: '<pattern id="fabric" width="12" height="12" patternUnits="userSpaceOnUse"><rect width="12" height="12" fill="#fff" fill-opacity=".92"/><path d="M0 0L12 12M12 0L0 12" stroke="#eee3e0" stroke-width=".7"/></pattern>',
    organza: '<linearGradient id="fabric" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff" stop-opacity=".96"/><stop offset=".5" stop-color="#f6e9e5" stop-opacity=".76"/><stop offset="1" stop-color="#fff" stop-opacity=".92"/></linearGradient>',
    sparkle: '<pattern id="fabric" width="26" height="26" patternUnits="userSpaceOnUse"><rect width="26" height="26" fill="#fffdfb"/><circle cx="6" cy="7" r="1.3" fill="#d2aeb1"/><circle cx="19" cy="17" r="1" fill="#c5b2aa"/><path d="M16 3v5M13.5 5.5h5" stroke="#e0bfc2"/></pattern>',
  }[design.fabric];
  return { base, defs: texture || `<linearGradient id="fabric"><stop stop-color="${base}"/></linearGradient>` };
}

function necklinePath(design: DressDesign, back: boolean) {
  if (back) {
    if (design.back === 'open') return 'M174 156 Q220 246 266 156 L270 262 L170 262Z';
    if (design.back === 'lowV') return 'M174 156 L220 226 L266 156 L270 262 L170 262Z';
    return 'M174 156 Q220 180 266 156 L270 262 L170 262Z';
  }
  switch (design.neckline) {
    case 'sweetheart': return 'M169 157 Q193 137 220 170 Q247 137 271 157 L270 264 L170 264Z';
    case 'v': return 'M169 154 L220 218 L271 154 L270 264 L170 264Z';
    case 'square': return 'M170 149 L190 149 L190 188 L250 188 L250 149 L270 149 L270 264 L170 264Z';
    case 'scoop': return 'M170 151 Q220 207 270 151 L270 264 L170 264Z';
    case 'high': return 'M185 117 Q220 102 255 117 L270 264 L170 264Z';
    case 'illusion': return 'M185 116 Q220 104 255 116 L271 157 Q245 176 220 174 Q195 176 169 157Z M170 157H270V264H170Z';
    default: return 'M170 157 Q220 166 270 157 L270 264 L170 264Z';
  }
}

function shoulderShapes(design: DressDesign, back: boolean) {
  const fill = 'url(#fabric)';
  const common = `fill="${fill}" stroke="#8b7a75" stroke-width="2.2" stroke-linejoin="round"`;
  switch (design.shoulder) {
    case 'offShoulder':
      return `<path d="M170 155 Q144 156 130 180 Q151 190 173 183M270 155 Q296 156 310 180 Q289 190 267 183" ${common}/>`;
    case 'spaghetti':
      return `<path d="M181 158L183 116M259 158L257 116" fill="none" stroke="#8b7a75" stroke-width="5" stroke-linecap="round"/>`;
    case 'halter':
      return `<path d="M181 160 Q195 132 202 112 L220 99 L238 112 Q245 132 259 160" ${common}/>`;
    case 'oneShoulder':
      return `<path d="M170 159 Q183 128 202 112 L234 149 L270 160 L267 190 L199 151 L174 190Z" ${common}/>`;
    case 'capSleeve':
      return `<path d="M172 154 Q147 147 137 170 Q149 190 174 181M268 154 Q293 147 303 170 Q291 190 266 181" ${common}/>`;
    case 'longSleeve':
      return `<path d="M173 154 Q145 150 137 180 L119 309 Q131 320 145 310 L176 181M267 154 Q295 150 303 180 L321 309 Q309 320 295 310 L264 181" ${common}/>`;
    default:
      return back ? '' : '';
  }
}

function waistPath(design: DressDesign) {
  if (design.waist === 'empire') return '<path d="M174 218Q220 228 266 218" class="seam"/>';
  if (design.waist === 'basque') return '<path d="M171 263L220 292L269 263" class="seam"/>';
  if (design.waist === 'drop') return '<path d="M169 291Q220 302 271 291" class="seam"/>';
  return '<path d="M170 264Q220 274 270 264" class="seam"/>';
}

function skirtPath(design: DressDesign) {
  switch (design.skirt) {
    case 'ballgown': return 'M170 262 Q140 291 100 380 Q70 474 45 628 Q220 684 395 628 Q370 474 340 380 Q300 291 270 262Z';
    case 'mermaid': return 'M170 262 Q176 360 184 478 Q178 531 116 628 Q220 666 324 628 Q262 531 256 478 Q264 360 270 262Z';
    case 'fitFlare': return 'M170 262 Q174 364 160 458 Q135 540 92 628 Q220 670 348 628 Q305 540 280 458 Q266 364 270 262Z';
    case 'sheath': return 'M170 262 Q182 414 178 628 Q220 650 262 628 Q258 414 270 262Z';
    case 'tea': return 'M170 262 Q139 338 111 475 Q220 520 329 475 Q301 338 270 262Z';
    default: return 'M170 262 Q131 366 76 628 Q220 674 364 628 Q309 366 270 262Z';
  }
}

function trainShape(design: DressDesign, back: boolean) {
  if (!back || design.train === 'none' || design.skirt === 'tea') return '';
  const path = design.train === 'short'
    ? 'M149 580Q220 651 291 580Q315 646 220 675Q125 646 149 580Z'
    : design.train === 'chapel'
      ? 'M125 565Q220 650 315 565Q370 663 220 714Q70 663 125 565Z'
      : 'M110 548Q220 648 330 548Q430 690 220 760Q10 690 110 548Z';
  return `<path d="${path}" fill="url(#fabric)" stroke="#8b7a75" stroke-width="2.2" opacity=".92"/>`;
}

function detailsMarkup(design: DressDesign, back: boolean) {
  const pieces: string[] = [];
  if (design.details.includes('drape')) pieces.push('<path d="M142 355Q220 386 298 355M123 414Q220 451 317 414M101 490Q220 535 339 490" fill="none" stroke="#d6c2bc" stroke-width="4" opacity=".72"/>');
  if (design.details.includes('corset') || (back && design.back === 'corset')) pieces.push('<path d="M183 177L257 251M257 177L183 251M220 169V259" fill="none" stroke="#bca5a0" stroke-width="2.4" opacity=".86"/>');
  if (design.details.includes('bead')) pieces.push('<g fill="#d0adb0"><circle cx="194" cy="196" r="4"/><circle cx="220" cy="218" r="3"/><circle cx="245" cy="191" r="4"/><circle cx="201" cy="239" r="3"/><circle cx="246" cy="242" r="3"/></g>');
  if (design.details.includes('pearl')) pieces.push('<g fill="#fff" stroke="#b9a19b"><circle cx="190" cy="205" r="5"/><circle cx="213" cy="190" r="5"/><circle cx="237" cy="207" r="5"/><circle cx="251" cy="232" r="5"/></g>');
  if (design.details.includes('flower')) pieces.push('<g fill="#f5dddf" stroke="#c49da0"><path d="M134 383q16-26 32 0q-16 25-32 0Z"/><path d="M274 452q20-31 40 0q-20 30-40 0Z"/><path d="M182 543q22-34 44 0q-22 33-44 0Z"/></g>');
  if (design.details.includes('bow')) pieces.push('<path d="M220 275Q185 244 178 282Q190 309 220 286Q250 309 262 282Q255 244 220 275Z" fill="#f3d9da" stroke="#a98b88" stroke-width="2"/>');
  if (design.details.includes('slit') && !back) pieces.push('<path d="M246 397L230 625" stroke="#8b7a75" stroke-width="3"/><path d="M246 397Q273 510 263 625" fill="#f4d2c7" opacity=".7"/>');
  if (design.details.includes('sheer')) pieces.push('<path d="M176 165H264V252H176Z" fill="#f7e9e5" opacity=".35" stroke="#d5beb8" stroke-dasharray="5 5"/>');
  if (back && design.back === 'buttons') pieces.push('<g fill="#c6aaa4">' + Array.from({ length: 8 }, (_, index) => `<circle cx="220" cy="${176 + index * 18}" r="3.5"/>`).join('') + '</g>');
  return pieces.join('');
}

function accessoriesMarkup(design: DressDesign) {
  const pieces: string[] = [];
  if (design.veil !== 'none') {
    const bottom = design.veil === 'long' ? 674 : 353;
    pieces.push(`<path d="M175 105Q220 67 265 105Q318 ${bottom - 160} 318 ${bottom}Q220 ${bottom + 28} 122 ${bottom}Q122 ${bottom - 160} 175 105Z" fill="#fff" opacity=".34" stroke="#d8c7c2" stroke-width="2"/>`);
  }
  if (design.bolero) pieces.push('<path d="M156 150Q220 111 284 150L269 231Q220 207 171 231Z" fill="#f7e9e5" opacity=".58" stroke="#bda6a0" stroke-dasharray="5 4"/>');
  if (design.gloves !== 'none') {
    const top = design.gloves === 'long' ? 201 : 272;
    pieces.push(`<path d="M135 ${top}L119 309Q131 320 145 310L157 ${top}Z M283 ${top}L295 310Q309 320 321 309L305 ${top}Z" fill="#fffaf7" stroke="#a58c87" stroke-width="2" opacity=".9"/>`);
  }
  return pieces.join('');
}

export function dressSvgMarkup(design: DressDesign, view: DressView = 'front', face?: FacePlacement, compact = false) {
  const back = view === 'back';
  const { defs } = fabricDefinition(design);
  const faceMarkup = face ? `<g clip-path="url(#faceClip)" transform="translate(${face.x} ${face.y}) rotate(${face.rotation} 220 80)"><image href="${esc(face.dataUrl)}" x="${175 - (face.scale - 1) * 45}" y="${34 - (face.scale - 1) * 45}" width="${90 * face.scale}" height="${105 * face.scale}" preserveAspectRatio="xMidYMid slice"/></g><ellipse cx="220" cy="83" rx="45" ry="52" fill="none" stroke="#aa918b" stroke-width="2"/>` : '<ellipse cx="220" cy="83" rx="42" ry="49" fill="#f1cec2"/><path d="M179 74Q187 24 220 25Q257 27 262 76Q251 48 220 46Q190 48 179 74Z" fill="#5b4842"/>';
  const title = compact ? '' : `<text x="220" y="792" text-anchor="middle" fill="#74615c" font-family="sans-serif" font-size="18">${back ? '뒷모습' : '앞모습'} 미리보기</text>`;
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 440 820" role="img" aria-label="조합한 드레스 ${back ? '뒷모습' : '앞모습'}"><defs>${defs}<clipPath id="faceClip"><ellipse cx="220" cy="83" rx="44" ry="51"/></clipPath><style>.seam{fill:none;stroke:#9a837e;stroke-width:3;stroke-linecap:round}</style></defs><rect width="440" height="820" rx="28" fill="#fbf7f5"/><ellipse cx="220" cy="748" rx="165" ry="22" fill="#e9dfdc"/>${accessoriesMarkup(design)}${trainShape(design, back)}<path d="M198 124Q220 138 242 124L249 162H191Z" fill="#efc9bd"/><path d="M173 154Q151 158 139 181L119 309Q131 320 145 310L172 191M267 154Q289 158 301 181L321 309Q309 320 295 310L268 191" fill="#efc9bd" stroke="#aa918b" stroke-width="2"/>${faceMarkup}<path d="${skirtPath(design)}" fill="url(#fabric)" stroke="#8b7a75" stroke-width="2.4" stroke-linejoin="round"/>${shoulderShapes(design, back)}<path d="${necklinePath(design, back)}" fill="url(#fabric)" stroke="#8b7a75" stroke-width="2.4" stroke-linejoin="round"/>${waistPath(design)}${detailsMarkup(design, back)}${title}</svg>`;
}

export function dressSvgDataUrl(design: DressDesign, view: DressView = 'front', face?: FacePlacement) {
  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(dressSvgMarkup(design, view, face, true))}`;
}

export function DressPreview({ design, view = 'front', face, className = '', style }: { design: DressDesign; view?: DressView; face?: FacePlacement; className?: string; style?: CSSProperties }) {
  return <div className={`dress-preview ${className}`} style={style} dangerouslySetInnerHTML={{ __html: dressSvgMarkup(design, view, face) }} />;
}

export type PreviewCategory = 'shoulder' | 'neckline' | 'waist' | 'skirt' | 'train' | 'fabric' | 'back' | 'veil' | 'gloves';

export function optionPreviewDesign(category: PreviewCategory, value: string): DressDesign {
  const design = structuredClone(defaultDesign);
  if (category === 'shoulder') design.shoulder = value as DressDesign['shoulder'];
  if (category === 'neckline') design.neckline = value as DressDesign['neckline'];
  if (category === 'waist') design.waist = value as DressDesign['waist'];
  if (category === 'skirt') { design.skirt = value as DressDesign['skirt']; if (value === 'tea') design.train = 'none'; }
  if (category === 'train') design.train = value as DressDesign['train'];
  if (category === 'fabric') design.fabric = value as DressDesign['fabric'];
  if (category === 'back') design.back = value as DressDesign['back'];
  if (category === 'veil') design.veil = value as DressDesign['veil'];
  if (category === 'gloves') design.gloves = value as DressDesign['gloves'];
  return design;
}

export function OptionThumbnail({ category, value }: { category: PreviewCategory; value: string }) {
  const design = optionPreviewDesign(category, value);
  const view: DressView = category === 'back' || category === 'train' ? 'back' : 'front';
  return <div className="option-thumbnail" dangerouslySetInnerHTML={{ __html: dressSvgMarkup(design, view, undefined, true) }} />;
}
EOF_DRESS
