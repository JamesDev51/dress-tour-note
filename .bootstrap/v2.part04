cat > src/app-state.tsx <<'EOF_STATE'
import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
import { clearTours, deleteTour, listTours, saveTour } from './db';
import { cloneTour, nowIso, touchTour, type TourDocument } from './domain';

type SaveState = 'idle' | 'saving' | 'saved' | 'error';

interface AppStateValue {
  ready: boolean;
  tours: TourDocument[];
  saveState: SaveState;
  error?: string;
  clearError: () => void;
  getTour: (id: string | undefined) => TourDocument | undefined;
  addTour: (tour: TourDocument) => Promise<void>;
  updateTour: (id: string, updater: (draft: TourDocument) => void) => void;
  replaceTour: (tour: TourDocument) => Promise<void>;
  removeTour: (id: string) => Promise<void>;
  copyTour: (tour: TourDocument) => Promise<TourDocument>;
  clearAll: () => Promise<void>;
  retrySave: () => Promise<void>;
}

const AppStateContext = createContext<AppStateValue | null>(null);

export function AppStateProvider({ children }: { children: ReactNode }) {
  const [ready, setReady] = useState(false);
  const [tours, setTours] = useState<TourDocument[]>([]);
  const [saveState, setSaveState] = useState<SaveState>('idle');
  const [error, setError] = useState<string>();
  const timers = useRef(new Map<string, number>());
  const latest = useRef(new Map<string, TourDocument>());

  const report = useCallback((reason: unknown) => {
    setSaveState('error');
    setError(reason instanceof Error ? reason.message : '로컬 저장 중 문제가 생겼어요.');
  }, []);

  useEffect(() => {
    listTours().then((items) => {
      setTours(items);
      items.forEach((tour) => latest.current.set(tour.id, tour));
      setReady(true);
    }).catch((reason) => {
      report(reason);
      setReady(true);
    });
    return () => timers.current.forEach((timer) => window.clearTimeout(timer));
  }, [report]);

  const persist = useCallback(async (tour: TourDocument) => {
    latest.current.set(tour.id, tour);
    setSaveState('saving');
    try {
      await saveTour(tour);
      if (latest.current.get(tour.id)?.updatedAt === tour.updatedAt) setSaveState('saved');
    } catch (reason) { report(reason); }
  }, [report]);

  const schedule = useCallback((tour: TourDocument) => {
    const existing = timers.current.get(tour.id);
    if (existing) window.clearTimeout(existing);
    setSaveState('saving');
    timers.current.set(tour.id, window.setTimeout(() => {
      timers.current.delete(tour.id);
      void persist(tour);
    }, 280));
  }, [persist]);

  const addTour = useCallback(async (tour: TourDocument) => {
    setTours((items) => [tour, ...items.filter((item) => item.id !== tour.id)]);
    await persist(tour);
  }, [persist]);

  const updateTour = useCallback((id: string, updater: (draft: TourDocument) => void) => {
    setTours((items) => items.map((tour) => {
      if (tour.id !== id) return tour;
      const draft = structuredClone(tour);
      updater(draft);
      const next = touchTour(draft);
      latest.current.set(id, next);
      schedule(next);
      return next;
    }));
  }, [schedule]);

  const replaceTour = useCallback(async (tour: TourDocument) => {
    const next = { ...tour, updatedAt: nowIso() };
    setTours((items) => [next, ...items.filter((item) => item.id !== next.id)]);
    await persist(next);
  }, [persist]);

  const removeTour = useCallback(async (id: string) => {
    const timer = timers.current.get(id);
    if (timer) window.clearTimeout(timer);
    timers.current.delete(id);
    latest.current.delete(id);
    setTours((items) => items.filter((tour) => tour.id !== id));
    try { await deleteTour(id); } catch (reason) { report(reason); }
  }, [report]);

  const copyTour = useCallback(async (source: TourDocument) => {
    const copy = cloneTour(source);
    await addTour(copy);
    return copy;
  }, [addTour]);

  const clearAll = useCallback(async () => {
    timers.current.forEach((timer) => window.clearTimeout(timer));
    timers.current.clear(); latest.current.clear(); setTours([]);
    try { await clearTours(); setSaveState('idle'); } catch (reason) { report(reason); }
  }, [report]);

  const retrySave = useCallback(async () => {
    const pending = [...latest.current.values()];
    try {
      setSaveState('saving');
      await Promise.all(pending.map(saveTour));
      setSaveState('saved'); setError(undefined);
    } catch (reason) { report(reason); }
  }, [report]);

  const value = useMemo<AppStateValue>(() => ({
    ready, tours, saveState, error, clearError: () => setError(undefined),
    getTour: (id) => tours.find((tour) => tour.id === id), addTour, updateTour, replaceTour, removeTour, copyTour, clearAll, retrySave,
  }), [ready, tours, saveState, error, addTour, updateTour, replaceTour, removeTour, copyTour, clearAll, retrySave]);

  return <AppStateContext.Provider value={value}>{children}</AppStateContext.Provider>;
}

export function useAppState() {
  const value = useContext(AppStateContext);
  if (!value) throw new Error('AppStateProvider가 필요합니다.');
  return value;
}
EOF_STATE
cat > src/components.tsx <<'EOF_COMPONENTS'
import { useEffect, useId, useRef, type ButtonHTMLAttributes, type InputHTMLAttributes, type ReactNode, type TextareaHTMLAttributes } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAppState } from './app-state';

export function AppShell({ title, eyebrow, back, actions, children, bottom }: { title?: string; eyebrow?: string; back?: boolean; actions?: ReactNode; children: ReactNode; bottom?: ReactNode }) {
  const navigate = useNavigate();
  const { saveState, error, clearError, retrySave } = useAppState();
  return <main className="app-shell">
    <header className="topbar">
      <div className="topbar-row">
        {back ? <button className="icon-button" aria-label="뒤로 가기" onClick={() => navigate(-1)}>‹</button> : <a className="brand" href="/">그드레스</a>}
        <div className="topbar-title-wrap">{eyebrow && <span className="eyebrow">{eyebrow}</span>}{title && <strong className="topbar-title">{title}</strong>}</div>
        <div className="topbar-actions">{actions}</div>
      </div>
      {saveState !== 'idle' && <div className={`save-indicator ${saveState}`}>{saveState === 'saving' ? '저장 중…' : saveState === 'saved' ? '✓ 자동 저장됨' : '저장 확인 필요'}</div>}
    </header>
    {error && <div className="error-banner" role="alert"><span>{error}</span><button onClick={() => void retrySave()}>다시 저장</button><button aria-label="닫기" onClick={clearError}>×</button></div>}
    <section className="page-content">{children}</section>
    {bottom && <div className="sticky-bottom">{bottom}</div>}
  </main>;
}

export function Button({ variant = 'primary', full = false, className = '', ...props }: ButtonHTMLAttributes<HTMLButtonElement> & { variant?: 'primary' | 'secondary' | 'ghost' | 'danger'; full?: boolean }) {
  return <button className={`button ${variant} ${full ? 'full' : ''} ${className}`} {...props} />;
}

export function TextField({ label, hint, ...props }: InputHTMLAttributes<HTMLInputElement> & { label: string; hint?: string }) {
  const id = useId();
  return <label className="field" htmlFor={id}><span>{label}</span><input id={id} {...props} />{hint && <small>{hint}</small>}</label>;
}

export function TextArea({ label, hint, ...props }: TextareaHTMLAttributes<HTMLTextAreaElement> & { label: string; hint?: string }) {
  const id = useId();
  return <label className="field" htmlFor={id}><span>{label}</span><textarea id={id} {...props} />{hint && <small>{hint}</small>}</label>;
}

export function Modal({ open, title, children, onClose }: { open: boolean; title: string; children: ReactNode; onClose: () => void }) {
  const panel = useRef<HTMLDivElement>(null);
  useEffect(() => {
    if (!open) return;
    const previous = document.activeElement as HTMLElement | null;
    panel.current?.focus();
    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') onClose();
      if (event.key === 'Tab' && panel.current) {
        const focusable = [...panel.current.querySelectorAll<HTMLElement>('button, input, textarea, select, [tabindex]:not([tabindex="-1"])')].filter((node) => !node.hasAttribute('disabled'));
        if (!focusable.length) return;
        const first = focusable[0]; const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
    };
    document.addEventListener('keydown', onKey);
    document.body.classList.add('modal-open');
    return () => { document.removeEventListener('keydown', onKey); document.body.classList.remove('modal-open'); previous?.focus(); };
  }, [open, onClose]);
  if (!open) return null;
  return <div className="modal-backdrop" role="presentation" onMouseDown={(event) => { if (event.target === event.currentTarget) onClose(); }}>
    <div className="modal-panel" role="dialog" aria-modal="true" aria-label={title} tabIndex={-1} ref={panel}>
      <div className="modal-head"><h2>{title}</h2><button className="icon-button" aria-label="닫기" onClick={onClose}>×</button></div>
      {children}
    </div>
  </div>;
}

export function EmptyState({ icon = '✦', title, description, action }: { icon?: string; title: string; description: string; action?: ReactNode }) {
  return <div className="empty-state"><span className="empty-icon">{icon}</span><h2>{title}</h2><p>{description}</p>{action}</div>;
}

export function StarRating({ label, value, onChange }: { label: string; value: number; onChange: (value: number) => void }) {
  return <div className="rating-row"><span>{label}</span><div className="stars" aria-label={`${label} ${value}점`}>{[1, 2, 3, 4, 5].map((score) => <button type="button" key={score} aria-label={`${score}점`} className={score <= value ? 'active' : ''} onClick={() => onChange(value === score ? 0 : score)}>★</button>)}</div></div>;
}

export function Segmented<T extends string>({ value, options, onChange, ariaLabel }: { value: T; options: readonly { value: T; label: string }[]; onChange: (value: T) => void; ariaLabel: string }) {
  return <div className="segmented" role="group" aria-label={ariaLabel}>{options.map((option) => <button type="button" key={option.value} className={option.value === value ? 'active' : ''} onClick={() => onChange(option.value)}>{option.label}</button>)}</div>;
}

export function LoadingScreen() {
  return <main className="app-shell"><div className="loading-screen"><span className="loader"/><strong>로컬 기록을 불러오는 중</strong></div></main>;
}
EOF_COMPONENTS
cat > src/App.tsx <<'EOF_APP'
import { useEffect, useState } from 'react';
import { Route, Routes } from 'react-router-dom';
import { AppStateProvider, useAppState } from './app-state';
import { LoadingScreen } from './components';
import { DressEditorPage, HomePage, ImportPage, NewTourPage, NotFoundPage, SettingsPage, ShopPage, TourPage } from './pages';

function AppRoutes() {
  const { ready } = useAppState();
  const [updateReady, setUpdateReady] = useState(false);
  useEffect(() => {
    const show = () => setUpdateReady(true);
    window.addEventListener('gudress:update', show);
    return () => window.removeEventListener('gudress:update', show);
  }, []);
  if (!ready) return <LoadingScreen />;
  return <>
    {updateReady && <div className="update-banner"><span>새 버전이 준비됐어요.</span><button onClick={() => window.location.reload()}>새로고침</button></div>}
    <Routes>
      <Route path="/" element={<HomePage />} />
      <Route path="/tour/new" element={<NewTourPage />} />
      <Route path="/tour/:tourId" element={<TourPage />} />
      <Route path="/tour/:tourId/shop/:shopId" element={<ShopPage />} />
      <Route path="/tour/:tourId/dress/:dressId" element={<DressEditorPage />} />
      <Route path="/import" element={<ImportPage />} />
      <Route path="/settings" element={<SettingsPage />} />
      <Route path="*" element={<NotFoundPage />} />
    </Routes>
  </>;
}

export default function App() {
  return <AppStateProvider><AppRoutes /></AppStateProvider>;
}
EOF_APP
