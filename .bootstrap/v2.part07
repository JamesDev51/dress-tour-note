cat > src/styles.css <<'EOF_STYLES'
:root {
  color: #352d2b;
  background: #ece6e3;
  font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard Variable", Pretendard, "Noto Sans KR", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --ink: #352d2b;
  --muted: #7b6964;
  --soft: #9d8b86;
  --line: #e4d8d4;
  --paper: #fbf7f5;
  --white: #fff;
  --rose: #a36f76;
  --rose-dark: #81545a;
  --rose-soft: #f2dddf;
  --danger: #b34e4e;
  --shadow: 0 18px 44px rgba(72, 49, 45, 0.1);
  --safe-bottom: max(18px, env(safe-area-inset-bottom));
}

* { box-sizing: border-box; }
html { min-height: 100%; background: #ece6e3; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: #ece6e3; }
body.modal-open { overflow: hidden; }
button, input, textarea, select { font: inherit; }
button { color: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid rgba(163, 111, 118, 0.32); outline-offset: 2px; }
button:disabled { opacity: 0.45; cursor: not-allowed; }
img, svg { display: block; max-width: 100%; }
h1, h2, h3, p { margin-top: 0; }

#root { min-height: 100vh; }
.app-shell {
  width: min(100%, 430px);
  min-height: 100dvh;
  margin: 0 auto;
  background: var(--paper);
  position: relative;
  box-shadow: 0 0 80px rgba(66, 46, 42, 0.11);
  overflow-x: clip;
}
.page-content { padding: 0 18px calc(116px + var(--safe-bottom)); }
.topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(251, 247, 245, 0.94);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(225, 211, 207, 0.72);
  padding-top: env(safe-area-inset-top);
}
.topbar-row { min-height: 64px; display: grid; grid-template-columns: 46px 1fr 46px; align-items: center; gap: 8px; padding: 8px 12px; }
.brand { grid-column: 1 / 3; color: var(--ink); text-decoration: none; font-size: 19px; font-weight: 850; letter-spacing: -0.7px; }
.topbar-title-wrap { min-width: 0; text-align: center; display: flex; flex-direction: column; align-items: center; line-height: 1.2; }
.topbar-title { width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 16px; }
.eyebrow { color: var(--rose); font-size: 10px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; }
.topbar-actions { display: flex; align-items: center; justify-content: flex-end; }
.icon-button { width: 42px; height: 42px; border: 0; border-radius: 50%; background: transparent; font-size: 24px; display: grid; place-items: center; cursor: pointer; }
.icon-button:active { background: #efe5e2; transform: scale(0.96); }
.save-indicator { position: absolute; right: 14px; bottom: -25px; border-radius: 999px; padding: 5px 9px; font-size: 10px; font-weight: 750; background: rgba(53, 45, 43, 0.87); color: #fff; box-shadow: 0 5px 16px rgba(53, 45, 43, 0.16); }
.save-indicator.error { background: var(--danger); }
.error-banner, .update-banner { position: sticky; top: calc(64px + env(safe-area-inset-top)); z-index: 35; display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: #fff2ee; color: #8d3e3e; font-size: 12px; border-bottom: 1px solid #eccac1; }
.error-banner span, .update-banner span { flex: 1; }
.error-banner button, .update-banner button { border: 0; background: transparent; font-weight: 800; color: inherit; }
.update-banner { background: #352d2b; color: white; }

.sticky-bottom { position: fixed; z-index: 50; left: 50%; bottom: 0; width: min(100%, 430px); transform: translateX(-50%); padding: 12px 18px var(--safe-bottom); background: linear-gradient(to bottom, rgba(251, 247, 245, 0), rgba(251, 247, 245, 0.98) 25%); }
.bottom-grid { display: grid; grid-template-columns: 1fr 92px; gap: 9px; }
.button { min-height: 50px; border: 1px solid transparent; border-radius: 16px; padding: 0 18px; font-weight: 800; font-size: 15px; cursor: pointer; transition: transform 0.15s ease, background 0.15s ease; }
.button:active { transform: scale(0.985); }
.button.full { width: 100%; }
.button.primary { color: #fff; background: var(--ink); box-shadow: 0 10px 24px rgba(53, 45, 43, 0.16); }
.button.secondary { background: var(--white); border-color: var(--line); color: var(--ink); }
.button.ghost { background: transparent; border-color: var(--line); color: var(--muted); }
.button.danger { background: #a84141; color: #fff; }
.danger-text { color: var(--danger) !important; }

.hero { margin: 0 -18px; padding: 62px 26px 38px; min-height: 615px; background: radial-gradient(circle at 78% 17%, rgba(213, 164, 170, 0.26), transparent 28%), linear-gradient(155deg, #fbf7f5 38%, #f2e4e2 100%); border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
.hero::after { content: ''; position: absolute; width: 270px; height: 400px; border: 1px solid rgba(163, 111, 118, 0.22); border-radius: 50% 50% 42% 42%; transform: rotate(17deg); right: -115px; top: 45px; }
.hero-kicker, .section-kicker { display: block; color: var(--rose); font-size: 11px; font-weight: 850; letter-spacing: 1.8px; }
.hero h1 { margin: 22px 0 20px; font-size: clamp(47px, 13vw, 60px); line-height: 1.04; letter-spacing: -3.4px; position: relative; z-index: 1; }
.hero h1 em { color: var(--rose); font-style: normal; }
.hero > p { max-width: 330px; color: var(--muted); font-size: 15px; line-height: 1.75; word-break: keep-all; position: relative; z-index: 1; }
.hero-actions { display: grid; gap: 9px; margin-top: 36px; position: relative; z-index: 2; }
.privacy-pill { display: inline-flex; margin-top: 18px; padding: 8px 11px; border-radius: 999px; background: rgba(255, 255, 255, 0.62); color: var(--muted); font-size: 11px; position: relative; z-index: 2; }

.section-block { padding: 34px 0 4px; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 12px; margin-bottom: 18px; }
.section-heading > div > span { color: var(--rose); font-size: 10px; font-weight: 850; letter-spacing: 1.3px; }
.section-heading h2 { margin: 4px 0 0; font-size: 25px; letter-spacing: -1px; }
.section-heading > strong { font-size: 34px; color: var(--line); }
.empty-state { border: 1px dashed #dac8c3; border-radius: 26px; padding: 42px 26px; text-align: center; background: rgba(255,255,255,0.52); }
.empty-icon { display: block; font-size: 38px; margin-bottom: 14px; color: var(--rose); font-weight: 800; }
.empty-state h2 { margin-bottom: 8px; font-size: 21px; }
.empty-state p { color: var(--muted); font-size: 14px; line-height: 1.65; word-break: keep-all; margin-bottom: 22px; }
.tour-list, .shop-list, .dress-list { display: grid; gap: 12px; }
.tour-card, .shop-card, .dress-card { background: #fff; border: 1px solid var(--line); border-radius: 22px; overflow: hidden; box-shadow: 0 8px 24px rgba(66, 46, 42, 0.04); }
.tour-card-main { width: 100%; border: 0; background: transparent; text-align: left; padding: 21px 20px 15px; position: relative; cursor: pointer; }
.tour-date { color: var(--rose); font-size: 11px; font-weight: 750; }
.tour-card h3 { margin: 9px 0 7px; font-size: 20px; letter-spacing: -0.6px; }
.tour-card p { margin: 0; color: var(--muted); font-size: 12px; }
.tour-open { position: absolute; right: 19px; top: 50%; transform: translateY(-50%); font-size: 13px; color: var(--soft); }
.card-menu, .shop-tools, .dress-card-tools { display: flex; justify-content: flex-end; gap: 3px; padding: 7px 10px; border-top: 1px solid #f0e8e6; }
.card-menu button, .shop-tools button, .dress-card-tools button { min-width: 40px; min-height: 34px; border: 0; background: transparent; border-radius: 10px; color: var(--muted); font-size: 12px; font-weight: 700; }

.form-stack { display: grid; gap: 20px; padding: 22px 0; }
.form-stack.compact { gap: 14px; padding: 4px 0; }
.intro-card { padding: 42px 26px 34px; margin: 0 -18px 8px; background: linear-gradient(135deg, #f3e1e2, #fff); border-bottom: 1px solid var(--line); }
.intro-card > span { color: var(--rose); font-size: 12px; font-weight: 850; }
.intro-card h1 { margin: 15px 0 14px; font-size: 40px; line-height: 1.1; letter-spacing: -2px; }
.intro-card p { margin: 0; color: var(--muted); font-size: 14px; }
.field { display: grid; gap: 8px; color: var(--ink); }
.field > span { font-size: 13px; font-weight: 750; }
.field input, .field textarea, .field select { width: 100%; border: 1px solid var(--line); border-radius: 15px; background: #fff; color: var(--ink); padding: 14px 15px; font-size: 15px; outline: none; transition: border 0.15s, box-shadow 0.15s; }
.field input { min-height: 51px; }
.field textarea { resize: vertical; min-height: 92px; line-height: 1.6; }
.field input:focus, .field textarea:focus, .field select:focus { border-color: var(--rose); box-shadow: 0 0 0 3px rgba(163, 111, 118, 0.11); }
.field small { color: var(--soft); font-size: 11px; line-height: 1.5; }
.two-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.notice-card { border-radius: 18px; padding: 17px 18px; background: #f1e8e5; color: var(--muted); }
.notice-card strong { color: var(--ink); font-size: 13px; }
.notice-card p { margin: 7px 0 0; font-size: 12px; line-height: 1.65; word-break: keep-all; }

.tour-overview { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 24px 0 18px; }
.tour-overview > div { min-height: 92px; border-radius: 18px; background: #fff; border: 1px solid var(--line); padding: 15px; display: flex; flex-direction: column; justify-content: space-between; }
.tour-overview span { color: var(--soft); font-size: 9px; font-weight: 800; letter-spacing: 0.8px; }
.tour-overview strong { font-size: 29px; }
.edit-panel, .option-section { border: 1px solid var(--line); border-radius: 19px; background: #fff; overflow: hidden; }
.edit-panel { margin-bottom: 18px; }
.edit-panel summary, .option-section summary { min-height: 57px; padding: 16px 18px; cursor: pointer; list-style: none; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: space-between; }
.edit-panel summary::-webkit-details-marker, .option-section summary::-webkit-details-marker { display: none; }
.edit-panel[open] summary, .option-section[open] summary { border-bottom: 1px solid var(--line); }
.edit-panel > .form-stack { padding: 16px; }
.face-card { display: grid; gap: 15px; background: #352d2b; color: white; padding: 23px; border-radius: 24px; margin-bottom: 24px; }
.face-card h2 { margin: 4px 0 7px; font-size: 22px; }
.face-card p { margin: 0; color: #d8cbc7; font-size: 12px; line-height: 1.55; }
.face-card small { color: #bcaeaa; font-size: 10px; line-height: 1.5; }
.face-card .button.secondary { background: transparent; color: white; border-color: #6f5e59; }
.face-row { display: grid; grid-template-columns: 72px 1fr; gap: 14px; align-items: center; }
.face-row img { width: 72px; height: 72px; object-fit: cover; border-radius: 50%; border: 2px solid #e5c4c7; }
.face-row > div { display: flex; align-items: flex-start; flex-direction: column; gap: 4px; min-width: 0; }
.face-row strong { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.face-row button { border: 0; background: transparent; color: #ead4d5; padding: 3px 0; font-size: 11px; font-weight: 700; }
.shop-main { width: 100%; min-height: 90px; display: grid; grid-template-columns: 46px 1fr 20px; gap: 10px; align-items: center; text-align: left; border: 0; background: transparent; padding: 17px; }
.shop-order { font-size: 14px; font-weight: 800; color: var(--rose); }
.shop-main h3 { margin: 0 0 5px; font-size: 18px; }
.shop-main p { margin: 0; color: var(--muted); font-size: 11px; }
.favorite-strip { display: grid; grid-auto-flow: column; grid-auto-columns: 152px; gap: 10px; overflow-x: auto; padding: 2px 0 10px; scroll-snap-type: x mandatory; }
.favorite-strip button { scroll-snap-align: start; border: 1px solid var(--line); border-radius: 18px; background: #fff; padding: 8px; text-align: left; }
.favorite-strip .dress-preview { height: 170px; overflow: hidden; border-radius: 12px; background: var(--paper); }
.favorite-strip strong, .favorite-strip span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.favorite-strip strong { margin-top: 8px; font-size: 12px; }
.favorite-strip span { color: var(--muted); font-size: 10px; margin-top: 3px; }
.inline-error { margin: 14px 0; border-radius: 14px; padding: 12px 14px; background: #fff0ec; color: #913e3e; display: flex; gap: 8px; font-size: 12px; }
.inline-error button { margin-left: auto; border: 0; background: transparent; color: inherit; }

.dress-card { display: grid; grid-template-columns: 142px 1fr; min-height: 190px; }
.dress-card.favorite { border-color: #d3a5aa; box-shadow: 0 10px 30px rgba(163, 111, 118, 0.1); }
.dress-card-preview { border: 0; border-right: 1px solid var(--line); background: var(--paper); padding: 0; position: relative; overflow: hidden; }
.dress-card-preview .dress-preview { width: 100%; height: 190px; }
.dress-card-preview .dress-preview svg { width: 100%; height: 100%; object-fit: cover; transform: scale(1.14); transform-origin: center 37%; }
.favorite-badge { position: absolute; top: 9px; left: 9px; padding: 5px 8px; border-radius: 999px; background: rgba(163,111,118,.93); color: #fff; font-size: 9px; font-weight: 800; }
.dress-card-copy { min-width: 0; display: flex; flex-direction: column; }
.dress-card-title { flex: 1; width: 100%; border: 0; background: transparent; text-align: left; padding: 20px 14px 10px; }
.dress-card-title strong, .dress-card-title span { display: block; }
.dress-card-title strong { font-size: 16px; margin-bottom: 8px; }
.dress-card-title span { color: var(--muted); font-size: 10px; line-height: 1.5; }
.dress-card-tools { flex-wrap: wrap; padding: 6px; }

.editor-preview-card { margin: 18px -4px 22px; border-radius: 28px; overflow: hidden; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); transition: margin .2s; }
.editor-preview-card.expanded { position: fixed; inset: env(safe-area-inset-top) 0 0; z-index: 80; width: min(100%,430px); margin: 0 auto; border: 0; border-radius: 0; overflow-y: auto; background: var(--paper); }
.preview-toolbar { padding: 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--line); }
.segmented { display: flex; gap: 3px; padding: 3px; background: #f0e7e4; border-radius: 12px; }
.segmented button { min-height: 34px; min-width: 72px; border: 0; border-radius: 9px; background: transparent; font-size: 11px; font-weight: 750; color: var(--muted); }
.segmented button.active { background: #fff; color: var(--ink); box-shadow: 0 2px 8px rgba(53,45,43,.08); }
.preview-expand { border: 0; background: transparent; color: var(--muted); font-size: 11px; font-weight: 750; padding: 9px; }
.editor-preview-card > .dress-preview { width: 100%; height: 430px; background: var(--paper); overflow: hidden; }
.editor-preview-card.expanded > .dress-preview { height: calc(100dvh - 150px); }
.editor-preview-card .dress-preview svg { width: 100%; height: 100%; }
.preview-caption { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 17px 20px 20px; border-top: 1px solid var(--line); }
.preview-caption > div { min-width: 0; }
.preview-caption span { color: var(--rose); font-size: 9px; font-weight: 850; letter-spacing: 1.2px; }
.preview-caption strong { display: block; margin-top: 4px; font-size: 18px; }
.editor-summary { margin: 4px 0 0; color: var(--muted); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.heart-mark { font-size: 26px !important; letter-spacing: 0 !important; }
.editor-name-card, .memo-card, .score-card, .face-adjust-card { margin: 0 0 22px; padding: 20px; border: 1px solid var(--line); border-radius: 23px; background: #fff; }
.editor-options { margin: 34px 0; }
.option-section { margin-bottom: 9px; }
.option-section summary > div { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.option-section summary strong { font-size: 14px; }
.option-section summary span:not(.summary-plus) { color: var(--muted); font-size: 11px; font-weight: 500; }
.summary-plus { color: var(--rose); font-size: 19px; transition: transform .15s; }
.option-section[open] .summary-plus { transform: rotate(45deg); }
.option-section-body { padding: 13px; }
.option-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.option-card { min-width: 0; border: 1px solid var(--line); border-radius: 15px; background: #fff; padding: 7px; position: relative; text-align: center; }
.option-card.selected { border: 2px solid var(--rose); background: #fff9f8; padding: 6px; }
.option-card > span { display: block; margin: 5px 0 3px; font-size: 11px; font-weight: 750; }
.option-card > b { position: absolute; right: 7px; top: 7px; width: 20px; height: 20px; border-radius: 50%; background: var(--rose); color: #fff; display: grid; place-items: center; font-size: 11px; }
.option-thumbnail { height: 132px; border-radius: 11px; overflow: hidden; background: var(--paper); }
.option-thumbnail svg { width: 100%; height: 100%; transform: scale(1.28); transform-origin: center 27%; }
.toggle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.toggle-option { min-height: 62px; display: grid; grid-template-columns: 26px 1fr 20px; gap: 8px; align-items: center; text-align: left; border: 1px solid var(--line); border-radius: 14px; padding: 10px 12px; background: #fff; font-size: 11px; font-weight: 700; }
.toggle-option.selected { border-color: var(--rose); background: #fff8f7; }
.toggle-option b { color: var(--rose); font-size: 15px; }
.detail-swatch { width: 25px; height: 25px; border-radius: 50%; background: #f1dfdd; display: block; position: relative; }
.detail-drape::after { content:''; position:absolute; inset:5px; border-top:2px solid #aa8a86; border-bottom:2px solid #aa8a86; border-radius:50%; }
.detail-corset::after { content:'×'; position:absolute; inset:0; display:grid; place-items:center; color:#96726f; }
.detail-bead::after, .detail-pearl::after { content:'•••'; position:absolute; inset:0; display:grid; place-items:center; color:#96726f; letter-spacing:1px; }
.detail-flower::after { content:'✿'; position:absolute; inset:0; display:grid; place-items:center; color:#96726f; }
.detail-bow::after { content:'∞'; position:absolute; inset:0; display:grid; place-items:center; color:#96726f; }
.detail-slit::after { content:'╱'; position:absolute; inset:0; display:grid; place-items:center; color:#96726f; }
.detail-sheer { opacity:.55; border:1px dashed #96726f; }
.bolero-visual { font-size: 22px; color: var(--rose); }
.favorite-cta { width: 100%; min-height: 54px; border: 1px solid #d7c4c0; border-radius: 17px; background: #fff; color: var(--ink); font-size: 15px; font-weight: 850; box-shadow: 0 10px 28px rgba(53,45,43,.1); }
.favorite-cta.active { color: #fff; background: var(--rose); border-color: var(--rose); }
.toast { position: fixed; z-index: 90; top: calc(74px + env(safe-area-inset-top)); left: 50%; width: min(calc(100% - 34px), 396px); transform: translateX(-50%); border-radius: 14px; padding: 12px 14px; background: rgba(53,45,43,.94); color: #fff; font-size: 12px; line-height: 1.5; box-shadow: var(--shadow); }
.face-adjust-card > p { color: var(--muted); font-size: 12px; line-height: 1.55; }
.range-field { display: grid; gap: 7px; margin-top: 15px; }
.range-field > span { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
.range-field b { color: var(--ink); }
.range-field input { width: 100%; accent-color: var(--rose); }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 20px; }
.chip-wrap button { min-height: 37px; border: 1px solid var(--line); border-radius: 999px; background: #fff; padding: 0 12px; font-size: 11px; font-weight: 700; }
.chip-wrap button.selected { background: var(--rose-soft); border-color: #d8aeb2; color: var(--rose-dark); }
.rating-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 50px; border-bottom: 1px solid #f0e8e6; }
.rating-row:last-child { border-bottom: 0; }
.rating-row > span { font-size: 12px; font-weight: 700; }
.stars { display: flex; }
.stars button { width: 29px; height: 36px; border: 0; background: transparent; color: #ded2cf; font-size: 20px; padding: 0; }
.stars button.active { color: #c4878e; }

.import-hero, .settings-privacy { margin: 0 -18px; padding: 50px 25px 38px; background: linear-gradient(145deg, #f1dfe0, #fbf7f5 75%); text-align: center; border-bottom: 1px solid var(--line); }
.import-icon { display: grid; place-items: center; width: 66px; height: 66px; margin: 0 auto 20px; border-radius: 50%; background: #fff; color: var(--rose); font-size: 31px; box-shadow: var(--shadow); }
.import-hero h1, .settings-privacy h1 { margin: 0 0 14px; font-size: 37px; line-height: 1.12; letter-spacing: -1.8px; }
.import-hero p, .settings-privacy p { color: var(--muted); font-size: 14px; line-height: 1.7; word-break: keep-all; }
.import-hero .button { margin-top: 20px; }
.import-hero small { display: block; margin-top: 13px; color: var(--soft); font-size: 10px; line-height: 1.55; }
.progress-card { margin-top: 20px; display: flex; align-items: center; gap: 14px; border: 1px solid var(--line); border-radius: 18px; padding: 16px; background: #fff; }
.progress-card > div { flex: 1; display: grid; gap: 8px; }
.progress-card strong { font-size: 12px; }
progress { width: 100%; height: 7px; accent-color: var(--rose); }
.loader { width: 25px; height: 25px; border: 3px solid #e5d8d4; border-top-color: var(--rose); border-radius: 50%; animation: spin .75s linear infinite; flex: 0 0 auto; }
@keyframes spin { to { transform: rotate(360deg); } }
.import-error, .import-result { margin-top: 22px; border: 1px solid var(--line); border-radius: 24px; padding: 24px; background: #fff; }
.import-error { background: #fff3f0; border-color: #eccac1; }
.import-error strong { color: var(--danger); }
.import-error p { color: var(--muted); font-size: 12px; line-height: 1.6; }
.import-result { text-align: center; }
.success-mark { width: 54px; height: 54px; display: grid; place-items: center; margin: 0 auto 14px; border-radius: 50%; background: var(--rose-soft); color: var(--rose-dark); font-size: 25px; font-weight: 800; }
.import-result h2 { margin: 6px 0 3px; font-size: 23px; }
.source-file { color: var(--soft); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.import-stats { display: grid; grid-template-columns: repeat(3,1fr); margin: 22px 0; border: 1px solid var(--line); border-radius: 17px; overflow: hidden; }
.import-stats > div { padding: 15px 5px; border-right: 1px solid var(--line); }
.import-stats > div:last-child { border-right: 0; }
.import-stats strong, .import-stats span { display: block; }
.import-stats strong { font-size: 25px; }
.import-stats span { color: var(--muted); font-size: 9px; margin-top: 3px; }
.import-result dl { display: grid; gap: 8px; margin: 0 0 20px; text-align: left; }
.import-result dl > div { display: flex; justify-content: space-between; gap: 14px; font-size: 11px; }
.import-result dt { color: var(--muted); }
.import-result dd { margin: 0; font-weight: 700; text-align: right; }
.import-result .button + .button { margin-top: 8px; }
.import-result + .notice-card, .import-error + .notice-card, .import-hero + .notice-card { margin-top: 20px; }

.settings-privacy > span { display: block; font-size: 35px; margin-bottom: 16px; }
.settings-list { display: grid; gap: 9px; margin: 24px 0; }
.settings-list article { min-height: 78px; border: 1px solid var(--line); border-radius: 18px; background: #fff; padding: 13px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.settings-list article > div { display: flex; align-items: center; gap: 12px; min-width: 0; }
.settings-icon { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 13px; background: #f1e7e4; color: var(--rose); font-weight: 800; }
.settings-list strong { display: block; font-size: 12px; }
.settings-list p { margin: 4px 0 0; color: var(--muted); font-size: 10px; line-height: 1.45; }
.settings-list article > span, .settings-list article > button { flex: 0 0 auto; color: var(--muted); font-size: 10px; }
.settings-list article > button { border: 0; border-radius: 10px; background: #f2e8e5; padding: 9px 10px; color: var(--rose-dark); font-weight: 800; }
.settings-help, .danger-zone { border-radius: 22px; padding: 21px; margin: 22px 0; }
.settings-help { background: #f1e9e6; }
.settings-help h2, .danger-zone h2 { font-size: 17px; }
.settings-help ul { margin: 0 0 12px; padding-left: 18px; color: var(--muted); font-size: 11px; line-height: 1.9; }
.settings-help p, .danger-zone p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
.danger-zone { border: 1px solid #e5c7c1; background: #fff8f6; }
.danger-zone > span { color: var(--danger); font-size: 9px; font-weight: 850; letter-spacing: 1.2px; }
.danger-zone h2 { margin: 7px 0; }
.danger-zone .button { margin-top: 18px; }
.app-footer { padding: 20px 0 6px; text-align: center; color: var(--soft); font-size: 10px; display: grid; gap: 5px; }

.modal-backdrop { position: fixed; z-index: 100; inset: 0; background: rgba(31,24,22,.46); display: flex; align-items: flex-end; justify-content: center; padding-top: env(safe-area-inset-top); }
.modal-panel { width: min(100%,430px); max-height: 90dvh; overflow-y: auto; border-radius: 28px 28px 0 0; background: var(--paper); padding: 18px 18px var(--safe-bottom); box-shadow: 0 -20px 60px rgba(31,24,22,.18); outline: none; }
.modal-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 12px; }
.modal-head h2 { margin: 0; font-size: 19px; }
.modal-copy { color: var(--muted); font-size: 13px; line-height: 1.65; word-break: keep-all; }
.modal-copy strong { color: var(--ink); }
.modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 22px; }
.progress-box { display: grid; justify-items: center; text-align: center; gap: 14px; padding: 24px 10px 18px; }
.progress-box strong { font-size: 14px; }
.progress-box small { color: var(--muted); font-size: 10px; }
.loading-screen { min-height: 100dvh; display: grid; place-content: center; justify-items: center; gap: 15px; color: var(--muted); font-size: 12px; }

@media (max-width: 350px) {
  .page-content { padding-left: 14px; padding-right: 14px; }
  .two-columns { grid-template-columns: 1fr; }
  .tour-overview > div { padding: 11px; }
  .tour-overview strong { font-size: 24px; }
  .dress-card { grid-template-columns: 120px 1fr; }
  .option-thumbnail { height: 112px; }
  .rating-row { align-items: flex-start; flex-direction: column; padding: 9px 0; }
}

@media (min-width: 431px) {
  body { padding: 20px 0; }
  .app-shell { min-height: calc(100dvh - 40px); border-radius: 24px; }
  .sticky-bottom { bottom: 20px; border-radius: 0 0 24px 24px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
EOF_STYLES
