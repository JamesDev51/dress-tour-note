cat > src/domain.ts <<'EOF_DOMAIN'
import { z } from 'zod';

export const shoulderOptions = ['strapless', 'offShoulder', 'spaghetti', 'halter', 'oneShoulder', 'capSleeve', 'longSleeve'] as const;
export const necklineOptions = ['sweetheart', 'straight', 'v', 'square', 'scoop', 'high', 'illusion'] as const;
export const waistOptions = ['natural', 'basque', 'empire', 'drop'] as const;
export const skirtOptions = ['aline', 'ballgown', 'mermaid', 'fitFlare', 'sheath', 'tea'] as const;
export const trainOptions = ['none', 'short', 'chapel', 'cathedral'] as const;
export const fabricOptions = ['mikado', 'satin', 'lace', 'tulle', 'organza', 'sparkle'] as const;
export const detailOptions = ['drape', 'corset', 'bead', 'pearl', 'flower', 'bow', 'slit', 'sheer'] as const;
export const backOptions = ['closed', 'lowV', 'open', 'corset', 'buttons'] as const;
export const veilOptions = ['none', 'short', 'long'] as const;
export const gloveOptions = ['none', 'short', 'long'] as const;
export const quickTagOptions = ['상체 예쁨', '허리 예쁨', '얼굴이 살아남', '날씬해 보임', '사진빨 좋을 듯', '생각보다 무거움', '움직이기 불편', '신부 픽', '신랑 픽'] as const;

export type Shoulder = (typeof shoulderOptions)[number];
export type Neckline = (typeof necklineOptions)[number];
export type Waist = (typeof waistOptions)[number];
export type Skirt = (typeof skirtOptions)[number];
export type Train = (typeof trainOptions)[number];
export type Fabric = (typeof fabricOptions)[number];
export type Detail = (typeof detailOptions)[number];
export type Back = (typeof backOptions)[number];
export type Veil = (typeof veilOptions)[number];
export type Glove = (typeof gloveOptions)[number];
export type QuickTag = (typeof quickTagOptions)[number];
export type DressView = 'front' | 'back';

export interface DressDesign {
  shoulder: Shoulder;
  neckline: Neckline;
  waist: Waist;
  skirt: Skirt;
  train: Train;
  fabric: Fabric;
  details: Detail[];
  back: Back;
  veil: Veil;
  bolero: boolean;
  gloves: Glove;
}

export interface FacePlacement {
  dataUrl: string;
  fileName: string;
  x: number;
  y: number;
  scale: number;
  rotation: number;
}

export interface DressNote {
  id: string;
  shopId: string;
  order: number;
  name: string;
  design: DressDesign;
  memo: string;
  quickTags: QuickTag[];
  favorite: boolean;
  score: {
    bride: number;
    partner: number;
    comfort: number;
    photo: number;
  };
  view: DressView;
  createdAt: string;
  updatedAt: string;
}

export interface ShopNote {
  id: string;
  order: number;
  name: string;
  address: string;
  visitTime: string;
  consultant: string;
  memo: string;
  createdAt: string;
  updatedAt: string;
}

export interface TourDocument {
  schemaVersion: 2;
  id: string;
  title: string;
  brideName: string;
  partnerName: string;
  tourDate: string;
  generalMemo: string;
  face?: FacePlacement;
  shops: ShopNote[];
  dresses: DressNote[];
  createdAt: string;
  updatedAt: string;
}

export interface GudressBackup {
  app: 'gudress';
  formatVersion: 2;
  exportedAt: string;
  tour: TourDocument;
}

export const optionLabels = {
  shoulder: {
    strapless: '끈 없음', offShoulder: '오프숄더', spaghetti: '얇은 끈', halter: '홀터넥', oneShoulder: '한쪽 어깨', capSleeve: '짧은 소매', longSleeve: '긴 소매',
  },
  neckline: {
    sweetheart: '하트형', straight: '일자형', v: '브이넥', square: '스퀘어', scoop: '둥근형', high: '하이넥', illusion: '시스루넥',
  },
  waist: { natural: '기본 허리선', basque: 'V자 허리선', empire: '가슴 아래', drop: '낮은 허리선' },
  skirt: { aline: 'A라인', ballgown: '풍성한 벨라인', mermaid: '머메이드', fitFlare: '핏앤플레어', sheath: '슬림', tea: '미디 길이' },
  train: { none: '없음', short: '짧음', chapel: '보통', cathedral: '엄청 김' },
  fabric: { mikado: '실크·미카도', satin: '새틴', lace: '레이스', tulle: '튤', organza: '오간자', sparkle: '반짝이' },
  details: { drape: '드레이핑', corset: '코르셋', bead: '비즈', pearl: '진주', flower: '3D 플라워', bow: '리본', slit: '슬릿', sheer: '시스루' },
  back: { closed: '막힌 등', lowV: '로우 V', open: '오픈백', corset: '코르셋 등', buttons: '단추 장식' },
  veil: { none: '베일 없음', short: '짧은 베일', long: '긴 베일' },
  gloves: { none: '장갑 없음', short: '짧은 장갑', long: '긴 장갑' },
} as const;

export const defaultDesign: DressDesign = {
  shoulder: 'offShoulder',
  neckline: 'sweetheart',
  waist: 'natural',
  skirt: 'aline',
  train: 'chapel',
  fabric: 'mikado',
  details: [],
  back: 'lowV',
  veil: 'none',
  bolero: false,
  gloves: 'none',
};

export function uid(prefix: string) {
  return `${prefix}_${crypto.randomUUID()}`;
}

export function nowIso() {
  return new Date().toISOString();
}

export function todayLocal() {
  const date = new Date();
  const offset = date.getTimezoneOffset() * 60_000;
  return new Date(date.getTime() - offset).toISOString().slice(0, 10);
}

export function createTour(input?: Partial<Pick<TourDocument, 'title' | 'brideName' | 'partnerName' | 'tourDate'>>) : TourDocument {
  const now = nowIso();
  return {
    schemaVersion: 2,
    id: uid('tour'),
    title: input?.title?.trim() || '나의 드레스투어',
    brideName: input?.brideName?.trim() || '',
    partnerName: input?.partnerName?.trim() || '',
    tourDate: input?.tourDate || todayLocal(),
    generalMemo: '',
    shops: [],
    dresses: [],
    createdAt: now,
    updatedAt: now,
  };
}

export function createShop(tour: TourDocument, name = ''): ShopNote {
  const now = nowIso();
  return {
    id: uid('shop'),
    order: tour.shops.length,
    name: name.trim() || `드레스샵 ${tour.shops.length + 1}`,
    address: '', visitTime: '', consultant: '', memo: '', createdAt: now, updatedAt: now,
  };
}

export function createDress(tour: TourDocument, shopId: string): DressNote {
  const siblings = tour.dresses.filter((dress) => dress.shopId === shopId);
  const now = nowIso();
  return {
    id: uid('dress'), shopId, order: siblings.length, name: `드레스 ${siblings.length + 1}`,
    design: structuredClone(defaultDesign), memo: '', quickTags: [], favorite: false,
    score: { bride: 0, partner: 0, comfort: 0, photo: 0 },
    view: 'front', createdAt: now, updatedAt: now,
  };
}

export function normalizeDesign(input: DressDesign): { design: DressDesign; corrected: boolean; message?: string } {
  const design = structuredClone(input);
  const before = JSON.stringify(design);
  let message: string | undefined;
  if (design.shoulder === 'halter' && !['high', 'scoop'].includes(design.neckline)) {
    design.neckline = 'high';
    message = '홀터넥에 맞춰 목선을 하이넥으로 보정했어요.';
  }
  if (design.shoulder === 'oneShoulder' && design.neckline === 'sweetheart') {
    design.neckline = 'straight';
    message = '한쪽 어깨 디자인에 맞춰 가슴선을 일자형으로 보정했어요.';
  }
  if (design.skirt === 'tea' && design.train !== 'none') {
    design.train = 'none';
    message = '미디 길이 드레스는 트레인을 없음으로 보정했어요.';
  }
  if (design.skirt === 'sheath' && design.train === 'cathedral') {
    design.train = 'chapel';
    message = '슬림 실루엣에 맞춰 트레인을 보통 길이로 보정했어요.';
  }
  return { design, corrected: before !== JSON.stringify(design), message };
}

export function touchTour(tour: TourDocument): TourDocument {
  return { ...tour, updatedAt: nowIso() };
}

export function dressStyleSummary(dress: DressNote) {
  const d = dress.design;
  const values = [optionLabels.shoulder[d.shoulder], optionLabels.neckline[d.neckline], optionLabels.waist[d.waist], optionLabels.skirt[d.skirt], optionLabels.fabric[d.fabric], optionLabels.train[d.train]];
  return values.join(' · ');
}

export function averageScore(dress: DressNote) {
  const values = Object.values(dress.score).filter((value) => value > 0);
  if (!values.length) return 0;
  return Math.round((values.reduce((sum, value) => sum + value, 0) / values.length) * 10) / 10;
}

export function cloneTour(source: TourDocument): TourDocument {
  const tour = structuredClone(source);
  const shopMap = new Map<string, string>();
  tour.id = uid('tour');
  tour.title = `${source.title} 사본`;
  tour.createdAt = nowIso();
  tour.updatedAt = tour.createdAt;
  tour.shops = tour.shops.map((shop) => {
    const id = uid('shop'); shopMap.set(shop.id, id);
    return { ...shop, id, createdAt: tour.createdAt, updatedAt: tour.createdAt };
  });
  tour.dresses = tour.dresses.map((dress) => ({
    ...dress, id: uid('dress'), shopId: shopMap.get(dress.shopId)!, createdAt: tour.createdAt, updatedAt: tour.createdAt,
  }));
  return tour;
}

const designSchema = z.object({
  shoulder: z.enum(shoulderOptions), neckline: z.enum(necklineOptions), waist: z.enum(waistOptions), skirt: z.enum(skirtOptions), train: z.enum(trainOptions), fabric: z.enum(fabricOptions),
  details: z.array(z.enum(detailOptions)), back: z.enum(backOptions), veil: z.enum(veilOptions), bolero: z.boolean(), gloves: z.enum(gloveOptions),
});
const faceSchema = z.object({ dataUrl: z.string().startsWith('data:image/'), fileName: z.string(), x: z.number().min(-100).max(100), y: z.number().min(-100).max(100), scale: z.number().min(0.2).max(4), rotation: z.number().min(-180).max(180) });
const shopSchema = z.object({ id: z.string(), order: z.number(), name: z.string(), address: z.string(), visitTime: z.string(), consultant: z.string(), memo: z.string(), createdAt: z.string(), updatedAt: z.string() });
const dressSchema = z.object({
  id: z.string(), shopId: z.string(), order: z.number(), name: z.string(), design: designSchema, memo: z.string(), quickTags: z.array(z.enum(quickTagOptions)), favorite: z.boolean(),
  score: z.object({ bride: z.number().min(0).max(5), partner: z.number().min(0).max(5), comfort: z.number().min(0).max(5), photo: z.number().min(0).max(5) }),
  view: z.enum(['front', 'back']), createdAt: z.string(), updatedAt: z.string(),
});
const tourSchema = z.object({
  schemaVersion: z.literal(2), id: z.string(), title: z.string(), brideName: z.string(), partnerName: z.string(), tourDate: z.string(), generalMemo: z.string(), face: faceSchema.optional(),
  shops: z.array(shopSchema), dresses: z.array(dressSchema), createdAt: z.string(), updatedAt: z.string(),
});
const backupSchema = z.object({ app: z.literal('gudress'), formatVersion: z.literal(2), exportedAt: z.string(), tour: tourSchema });

export function validateTourRelationships(tour: TourDocument) {
  const shopIds = new Set(tour.shops.map((shop) => shop.id));
  const duplicateShops = shopIds.size !== tour.shops.length;
  const dressIds = new Set(tour.dresses.map((dress) => dress.id));
  if (duplicateShops || dressIds.size !== tour.dresses.length) throw new Error('중복된 기록 ID가 있어요.');
  if (tour.dresses.some((dress) => !shopIds.has(dress.shopId))) throw new Error('드레스와 드레스샵 연결 정보가 올바르지 않아요.');
}

export function parseBackup(value: unknown): GudressBackup {
  const parsed = backupSchema.safeParse(value);
  if (!parsed.success) throw new Error('이 PDF에는 불러올 수 있는 그드레스 원본 데이터가 없어요.');
  const backup = parsed.data as GudressBackup;
  validateTourRelationships(backup.tour);
  return backup;
}

export function makeBackup(tour: TourDocument): GudressBackup {
  return { app: 'gudress', formatVersion: 2, exportedAt: nowIso(), tour };
}
EOF_DOMAIN
cat > src/db.ts <<'EOF_DB'
import Dexie, { type EntityTable } from 'dexie';
import type { TourDocument } from './domain';

interface StoredTour {
  id: string;
  title: string;
  tourDate: string;
  updatedAt: string;
  document: TourDocument;
}

class GudressDatabase extends Dexie {
  tours!: EntityTable<StoredTour, 'id'>;
  constructor() {
    super('gudress-local-v2');
    this.version(1).stores({ tours: 'id, updatedAt, tourDate' });
  }
}

export const db = new GudressDatabase();

export async function listTours() {
  const rows = await db.tours.orderBy('updatedAt').reverse().toArray();
  return rows.map((row) => row.document);
}

export async function loadTour(id: string) {
  return (await db.tours.get(id))?.document;
}

export async function saveTour(document: TourDocument) {
  await db.tours.put({ id: document.id, title: document.title, tourDate: document.tourDate, updatedAt: document.updatedAt, document });
}

export async function deleteTour(id: string) {
  await db.tours.delete(id);
}

export async function clearTours() {
  await db.tours.clear();
}

export async function databaseUsage() {
  if (!navigator.storage?.estimate) return undefined;
  return navigator.storage.estimate();
}
EOF_DB
cat > src/image.ts <<'EOF_IMAGE'
import type { FacePlacement } from './domain';

function readFile(file: File) {
  return new Promise<string>((resolve, reject) => {
    const reader = new FileReader();
    reader.onerror = () => reject(new Error('사진을 읽지 못했어요.'));
    reader.onload = () => resolve(String(reader.result));
    reader.readAsDataURL(file);
  });
}

function loadImage(src: string) {
  return new Promise<HTMLImageElement>((resolve, reject) => {
    const image = new Image();
    image.onload = () => resolve(image);
    image.onerror = () => reject(new Error('사진 형식을 확인해 주세요.'));
    image.src = src;
  });
}

export async function processFacePhoto(file: File): Promise<FacePlacement> {
  if (!file.type.startsWith('image/')) throw new Error('이미지 파일만 선택할 수 있어요.');
  if (file.size > 12 * 1024 * 1024) throw new Error('12MB 이하 사진을 선택해 주세요.');
  const source = await readFile(file);
  const image = await loadImage(source);
  const max = 1200;
  const ratio = Math.min(1, max / Math.max(image.naturalWidth, image.naturalHeight));
  const canvas = document.createElement('canvas');
  canvas.width = Math.max(1, Math.round(image.naturalWidth * ratio));
  canvas.height = Math.max(1, Math.round(image.naturalHeight * ratio));
  const context = canvas.getContext('2d');
  if (!context) throw new Error('사진 편집기를 열지 못했어요.');
  context.drawImage(image, 0, 0, canvas.width, canvas.height);
  return { dataUrl: canvas.toDataURL('image/webp', 0.82), fileName: file.name, x: 0, y: 0, scale: 1, rotation: 0 };
}
EOF_IMAGE
